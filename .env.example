# Copy this file to .env and fill in the values.

# --- Database (PostgreSQL / Neon) -------------------------------------------
# Pooled connection used by the app at runtime (src/lib/db.ts).
DATABASE_URL=
# Direct, non-pooled connection used by the Prisma CLI for migrations
# (prisma.config.ts). Required by `pnpm prisma migrate dev`.
DIRECT_URL=

# --- App / auth --------------------------------------------------------------
# Base URL the auth client calls, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Random secret used by better-auth to sign sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same origin as NEXT_PUBLIC_APP_URL, e.g. http://localhost:3000
BETTER_AUTH_URL=

# --- Cloudinary (product and profile images) ---------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (verification email) ---------------------------------------------
RESEND_API_KEY=

# --- First-admin bootstrap ----------------------------------------------------
# Gates /api/setup, which creates the first ADMIN account.
# Development only — never set this in a deployed environment.
SETUP_SECRET=
